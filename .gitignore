# Build output. The binary has to be called `tallox`, not `tallox.go` — otherwise the
# next build feeds its own binary to the compiler as a source file. Enforced in
# `gowatch.yml`.
/tallox
/dist/

# Configuration holding secrets. Local machine and host only.
tallox.yaml
.env

# Claude
.claude/settings.local.json

# macOS
.DS_Store
